// Version settings for every Moonlight target.
//
// The build number is deliberately absent from source control. It used to live
// in project.yml, which meant every build was a commit and two branches could
// not raise it independently without colliding. What is committed here is only
// a floor; the real number is written to Version.generated.xcconfig by
// Scripts/version.sh and by ci_scripts/ci_post_clone.sh, neither of which is
// tracked by Git.
//
// Local builds number themselves from the commit count. Xcode Cloud numbers its
// own builds and starts at 1000, so the two never share a value.

MARKETING_VERSION = 2.0-alpha

// The floor. A checkout with no generated file still builds and still produces
// a valid CFBundleVersion; it just does not claim a number it did not earn.
CURRENT_PROJECT_VERSION = 1

// Optional by design: the include is skipped when the file is missing, which is
// the normal state of a fresh clone.
#include? "Version.generated.xcconfig"
